# Backend configuration. Copy to backend/.env for local development.
PORT=4000
NODE_ENV=development
# Keep mysql for local development; Neon is only selected when explicitly configured.
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=domain_hub
# For Neon/PostgreSQL, set DB_CLIENT=postgres and add its SSL-enabled URL.
DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
# Same-origin /api proxy keeps the session first-party; use lax in production.
COOKIE_SAME_SITE=lax
# Set true only when checking payment rollback behavior.
SIMULATE_PAYMENT_FAILURE=false
