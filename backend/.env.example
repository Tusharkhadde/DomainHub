# Backend configuration. Copy to backend/.env for local development.
PORT=4000
NODE_ENV=development
# Select mysql or postgres. MySQL is the local default.
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=domain_hub
# For PostgreSQL instead, set DB_CLIENT=postgres and provide this URL.
NEON_DATABASE_URL=postgresql://neondb_owner:npg_2alPhixYjgT4@ep-quiet-truth-b58jrbce-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Set true only when checking payment rollback behavior.
SIMULATE_PAYMENT_FAILURE=false
